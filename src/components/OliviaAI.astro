---
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
const es = lang === 'es';
---
<luxury-olivia lang={lang}>
  <template>
    <style is:inline>
      :host { position: fixed; right: 24px; bottom: 24px; z-index: 1000; font: 14px/1.5 'DM Sans', Arial, sans-serif; color: #2b2b2b; }
      * { box-sizing: border-box; } [hidden] { display: none !important; }
      button, input, textarea { font: inherit; } button, a { -webkit-tap-highlight-color: transparent; }
      button { cursor: pointer; } button:disabled { cursor: default; opacity: .5; }
      button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible { outline: 2px solid #c8aa70; outline-offset: 3px; }
      .toggle { display: flex; align-items: center; gap: 16px; height: 64px; margin-left: auto; padding: 7px 7px 7px 21px; border-radius: 40px; background: linear-gradient(135deg, #3d3932, #171512); color: white; border: 1px solid #c8aa7070; box-shadow: 0 18px 40px -16px #0009, inset 0 1px 0 #ffffff30; transition: transform .2s ease, box-shadow .2s ease; }
      .toggle-copy { display: grid; gap: 1px; text-align: left; }
      .toggle-name { font-size: 15px; font-weight: 500; letter-spacing: .02em; }
      .toggle-description { font-size: 10px; color: #e0c899; letter-spacing: .025em; }
      .toggle-icon { display: grid; place-items: center; width: 48px; height: 48px; border: 1px solid #c8aa7050; border-radius: 50%; background: #ffffff08; color: #efd9ad; }
      .toggle[aria-expanded="true"] { width: 64px; padding: 7px; justify-content: center; }
      .toggle[aria-expanded="true"] .toggle-copy { display: none; }
      svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      .panel { position: absolute; bottom: 84px; right: 0; display: flex; flex-direction: column; width: 430px; max-width: calc(100vw - 32px); height: min(700px, calc(100dvh - 130px)); border: 1px solid #ded7c9; border-radius: 28px; background: #fffdf8; overflow: hidden; box-shadow: 0 46px 78px -28px #14100ac7, 0 22px 38px -26px #14100aa3, inset 0 1px 0 #ffffffcc; animation: enter .22s ease-out; }
      header { display: flex; align-items: flex-start; gap: 12px; padding: 20px; color: white; background: #2b2b2b; border-bottom: 1px solid #c8aa70; }
      .avatar { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 50%; background: linear-gradient(145deg, #c8aa702b, #ffffff08); border: 1px solid #c8aa7060; color: #f4d99a; }
      h2 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -.02em; }
      .brand { margin: 2px 0 7px; font-size: 11px; color: #ffffffb3; }
      .status { display: inline-flex; align-items: center; gap: 7px; border-radius: 20px; background: #ffffff15; padding: 3px 9px; font-size: 11px; }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: #c8aa70; }
      .close { margin-left: auto; border: 0; border-radius: 50%; width: 30px; height: 30px; color: white; background: #ffffff15; font-size: 22px; line-height: 1; }
      .messages { flex: 1; min-height: 0; overflow-y: auto; padding: 20px 16px; background: #f7f2e9; display: flex; flex-direction: column; gap: 12px; overscroll-behavior: contain; }
      .message { flex: none; max-width: 90%; padding: 12px 15px; margin: 0; border-radius: 18px 18px 18px 4px; background: white; box-shadow: 0 2px 8px #14100a0a; white-space: pre-wrap; overflow-wrap: anywhere; }
      .user { align-self: flex-end; background: #2b2b2b; color: white; border-radius: 18px 18px 4px 18px; }
      .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px 16px; background: #f7f2e9; }
      .actions button { background: transparent; border: 1px solid #c8aa70; color: #5f5546; border-radius: 10px; font-size: 11px; font-weight: 600; padding: 8px 6px; transition: background .2s ease, border-color .2s ease; }
      .consent { padding: 10px 16px; font-size: 11px; border-top: 1px solid #e8e0d3; background: #fffdf8; }
      .consent label { display: flex; align-items: flex-start; gap: 8px; } .consent input { accent-color: #2b2b2b; margin-top: 4px; }
      a { color: #806839; text-underline-offset: 3px; } .contact { display: flex; justify-content: space-between; padding: 0 16px 10px; font-size: 11px; }
      .chat-form { padding: 12px 16px; display: flex; gap: 8px; border-top: 1px solid #ded7c9; background: #fffdf8; }
      .chat-form input { min-width: 0; width: 100%; border-radius: 12px; border: 1px solid #ded7c9; background: white; padding: 12px; color: #2b2b2b; }
      .open-contact { display: flex; align-items: center; justify-content: space-between; gap: 12px; width: 100%; padding: 8px 12px; border: 1px solid #ded2bb; border-radius: 10px; background: #f7f2e9; color: #5f4a25; text-align: left; transition: background .2s ease; }
      .open-contact svg { width: 16px; height: 16px; flex: none; }
      .lead-view { flex: 1; min-height: 0; overflow-y: auto; padding: 16px; }
      .lead-view h3 { margin: 0 0 8px; font-size: 17px; }
      .lead-view > p { margin: 0 0 14px; font-size: 12px; color: #625b51; }
      .lead-form { display: grid; gap: 10px; }
      .lead-row { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 10px; }
      .lead-form label { display: grid; gap: 4px; font-size: 12px; }
      .lead-note { margin: 0; font-size: 11px; color: #625b51; }
      .lead-form input, .lead-form textarea { width: 100%; min-width: 0; border: 1px solid #bfb5a4; border-radius: 8px; padding: 9px; background: white; color: #2b2b2b; }
      .lead-form textarea { resize: vertical; min-height: 80px; }
      .lead-buttons { display: flex; flex-wrap: wrap; flex-shrink: 0; gap: 8px; padding: 10px 16px; border-top: 1px solid #e8e0d3; background: #fffdf8; }
      .lead-submit, .back-to-chat { border: 1px solid #c8aa70; border-radius: 8px; padding: 9px 12px; background: #2b2b2b; color: white; }
      .back-to-chat { background: transparent; color: #5f5546; }
      .lead-feedback { margin: 0; color: #85402c; font-size: 12px; }
      .send { display: grid; place-items: center; border: none; border-radius: 12px; background: #2b2b2b; color: white; width: 46px; flex: none; }
      .error { margin: 0; padding: 7px 16px; background: #fff0e9; color: #85402c; font-size: 12px; }
      .footnote { padding: 0 16px 9px; font-size: 10px; color: #8b8275; text-align: center; }
      .typing { display: flex; align-items: center; gap: 5px; padding: 16px; }
      .typing-dot { width: 6px; height: 6px; border-radius: 50%; background: #9a7c44; animation: reply 1.2s ease-in-out infinite; }
      .typing-dot + .typing-dot { animation-delay: .15s; } .typing-dot + .typing-dot + .typing-dot { animation-delay: .3s; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; border: 0; }
      @keyframes reply { 0%, 60%, 100% { opacity: .4; transform: translateY(0); } 30% { opacity: 1; transform: translateY(-3px); } }
      @keyframes enter { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
      @media (hover: hover) { .toggle:hover { transform: translateY(-2px); box-shadow: 0 22px 44px -16px #000b, inset 0 1px 0 #ffffff30; } .actions button:hover:not(:disabled) { background: #eadfc9; border-color: #a88b55; } .open-contact:hover:not(:disabled) { background: #eadfc9; } }
      @media (max-width: 600px) { :host { right: 16px; bottom: 16px; } .panel { position: fixed; right: 12px; left: 12px; bottom: 92px; width: auto; max-width: none; height: min(660px, calc(100dvh - 110px)); border-radius: 24px; } header { padding: 16px; } .messages { padding: 16px; } }
      @media (max-width: 380px) { .lead-row { grid-template-columns: minmax(0, 1fr); } }
      @media (max-height: 650px) { .panel { position: fixed; right: 12px; bottom: 12px; height: calc(100dvh - 24px); } .toggle[aria-expanded="true"] { visibility: hidden; } header { padding: 14px; } .actions { display: flex; overflow-x: auto; flex-shrink: 0; padding: 8px 16px; } .actions button { flex: none; white-space: nowrap; } }
      @media (max-height: 450px) { .brand, .status, .footnote, .actions { display: none; } header { align-items: center; padding: 10px 16px; } .consent { padding: 6px 16px; font-size: 10px; } .chat-form { padding: 8px 16px; } }
      @media (prefers-reduced-motion: reduce) { .panel, .typing-dot { animation: none; } .toggle, .actions button, .open-contact { transition: none; } .toggle:hover { transform: none; } }
    </style>
    <section class="panel" role="dialog" aria-labelledby="olivia-title" hidden>
      <header>
        <span class="avatar" aria-hidden="true">✧</span>
        <div><h2 id="olivia-title">Olivia AI</h2><p class="brand">Luxury Villas by La Casa Que Canta</p><span class="status"><span class="dot" aria-hidden="true"></span>{es ? 'Concierge digital' : 'Digital concierge'}</span></div>
        <button class="close" aria-label={es ? 'Cerrar el chat' : 'Close chat'} type="button">×</button>
      </header>
      <div class="messages" role="log" aria-live="polite" aria-relevant="additions text"></div>
      <div class="actions">
        <button type="button" data-prompt={es ? '¿Cuál es la diferencia entre El Ensueño y El Murmullo?' : 'What is the difference between El Ensueño and El Murmullo?'}>{es ? 'Las villas' : 'The villas'}</button>
        <button type="button" data-prompt={es ? '¿Para cuántas personas es cada villa?' : 'How many guests can stay in each villa?'}>{es ? 'Suites y huéspedes' : 'Suites & guests'}</button>
        <button type="button" data-prompt={es ? '¿Qué servicios ofrece cada villa?' : 'What services does each villa offer?'}>{es ? 'Servicios' : 'Services'}</button>
        <button type="button" data-prompt={es ? 'Quisiera información sobre disponibilidad y tarifas.' : 'I would like information about availability and rates.'}>{es ? 'Disponibilidad y tarifas' : 'Availability & rates'}</button>
      </div>
      <section class="lead-view" aria-labelledby="olivia-contact-title" hidden>
        <h3 id="olivia-contact-title">{es ? 'Solicitar información' : 'Request information'}</h3>
        <p>{es ? 'Tus datos y tu conversación se enviarán a nuestro equipo de reservaciones.' : 'Your details and conversation will be sent to our reservations team.'}</p>
        <form class="lead-form" id="olivia-enquiry-form">
          <div class="lead-row">
            <label>{es ? 'Nombre' : 'First name'}<input name="firstName" autocomplete="given-name" required maxlength="100" /></label>
            <label>{es ? 'Apellido' : 'Last name'}<input name="lastName" autocomplete="family-name" required maxlength="100" /></label>
          </div>
          <div class="lead-row">
            <label>{es ? 'Fecha de llegada' : 'Arrival date'}<input name="arrivalDate" type="date" required /></label>
            <label>{es ? 'Salida (opcional)' : 'Departure (optional)'}<input name="departureDate" type="date" /></label>
          </div>
          <label>{es ? 'Correo electrónico' : 'Email address'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <div class="lead-row">
            <label>{es ? 'Teléfono móvil' : 'Mobile number'}<input name="phone" type="tel" autocomplete="tel" maxlength="60" aria-describedby="olivia-phone-note" /></label>
            <label>WhatsApp<input name="whatsapp" type="tel" maxlength="60" aria-describedby="olivia-phone-note" /></label>
          </div>
          <p class="lead-note" id="olivia-phone-note">{es ? 'Indica al menos un número, con código de país. Puedes usar el mismo para móvil y WhatsApp.' : 'Provide at least one number, including the country code. You can use the same number for mobile and WhatsApp.'}</p>
          <label>{es ? 'Tu consulta' : 'Your enquiry'}<textarea name="message" rows="3" required maxlength="5000"></textarea></label>
          <p class="lead-feedback" role="status" aria-live="polite"></p>
        </form>
      </section>
      <div class="consent"><label><input type="checkbox" /><span>{es ? 'He leído y acepto el ' : 'I have read and accept the '}<a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">{es ? 'Aviso de Privacidad' : 'Privacy Notice'}</a>{es ? ' para conversar con Olivia. Al enviar una consulta, comparto mis datos y mi conversación con reservaciones.' : ' to chat with Olivia. When I send an enquiry, I share my details and conversation with reservations.'}</span></label></div>
      <div class="lead-buttons" hidden><button class="lead-submit" type="submit" form="olivia-enquiry-form" disabled>{es ? 'Enviar consulta' : 'Send enquiry'}</button><button class="back-to-chat" type="button">{es ? 'Volver al chat' : 'Back to chat'}</button></div>
      <div class="contact"><button class="open-contact" type="button"><span>{es ? 'Solicitar información' : 'Request information'}</span><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6"/></svg></button></div>
      <p class="error" role="alert" hidden></p>
      <form class="chat-form"><input type="text" aria-label={es ? 'Tu mensaje' : 'Your message'} placeholder={es ? 'Escribe tu pregunta…' : 'Ask your question…'} maxlength="2000" disabled /><button class="send" type="submit" aria-label={es ? 'Enviar' : 'Send'} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></button></form>
      <div class="footnote">{es ? 'Disponibilidad y tarifas confirmadas por reservas.' : 'Availability and rates confirmed by reservations.'}</div>
    </section>
    <button class="toggle" type="button" aria-label={es ? 'Abrir Olivia AI, tu concierge de villas' : 'Open Olivia AI, your villa concierge'} aria-expanded="false"><span class="toggle-copy"><span class="toggle-name">Olivia AI</span><span class="toggle-description">{es ? 'Tu concierge de villas' : 'Your villa concierge'}</span></span><span class="toggle-icon"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></span></button>
  </template>
</luxury-olivia>
<script>
  import { isBookingIntent, isPhoneNumber, todayInZihuatanejo } from '../../infrastructure/olivia/enquiry.mjs';

  class LuxuryOlivia extends HTMLElement {
    private polling?: ReturnType<typeof setInterval>;
    disconnectedCallback() { clearInterval(this.polling); }
    connectedCallback() {
      if (this.shadowRoot) return;
      const template = this.querySelector('template');
      if (!template) return;
      const root = this.attachShadow({ mode: 'open' });
      root.append(template.content.cloneNode(true));
      const panel = root.querySelector<HTMLElement>('.panel')!;
      const toggle = root.querySelector<HTMLButtonElement>('.toggle')!;
      const openLabel = toggle.getAttribute('aria-label')!;
      const input = root.querySelector<HTMLInputElement>('.chat-form input')!;
      const consent = root.querySelector<HTMLInputElement>('.consent input')!;
      const form = root.querySelector<HTMLFormElement>('.chat-form')!;
      const leadView = root.querySelector<HTMLElement>('.lead-view')!;
      const leadForm = root.querySelector<HTMLFormElement>('.lead-form')!;
      const leadName = root.querySelector<HTMLInputElement>('.lead-form [name="firstName"]')!;
      const arrival = root.querySelector<HTMLInputElement>('[name="arrivalDate"]')!;
      const departure = root.querySelector<HTMLInputElement>('[name="departureDate"]')!;
      const phone = root.querySelector<HTMLInputElement>('.lead-form [name="phone"]')!;
      const whatsapp = root.querySelector<HTMLInputElement>('[name="whatsapp"]')!;
      const leadMessage = root.querySelector<HTMLTextAreaElement>('.lead-form [name="message"]')!;
      const leadFeedback = root.querySelector<HTMLElement>('.lead-feedback')!;
      const leadSubmit = root.querySelector<HTMLButtonElement>('.lead-submit')!;
      const leadButtons = root.querySelector<HTMLElement>('.lead-buttons')!;
      const back = root.querySelector<HTMLButtonElement>('.back-to-chat')!;
      const openContact = root.querySelector<HTMLButtonElement>('.open-contact')!;
      const contact = root.querySelector<HTMLElement>('.contact')!;
      const actionSection = root.querySelector<HTMLElement>('.actions')!;
      const messages = root.querySelector<HTMLElement>('.messages')!;
      const error = root.querySelector<HTMLElement>('.error')!;
      const actions = [...root.querySelectorAll<HTMLButtonElement>('[data-prompt]')];
      const sendButton = root.querySelector<HTMLButtonElement>('.send')!;
      const es = this.lang === 'es';
      const setDateBounds = () => {
        arrival.min = todayInZihuatanejo();
        departure.min = arrival.value ? new Date(new Date(`${arrival.value}T12:00:00Z`).getTime() + 86400000).toISOString().slice(0, 10) : arrival.min;
      };
      const validatePhones = () => {
        const missing = !phone.value.trim() && !whatsapp.value.trim();
        const invalid = es ? 'Indica un número válido con código de país.' : 'Enter a valid number including the country code.';
        phone.setCustomValidity(missing ? (es ? 'Indica un móvil o un número de WhatsApp.' : 'Provide a mobile or WhatsApp number.') : phone.value.trim() && !isPhoneNumber(phone.value.trim()) ? invalid : '');
        whatsapp.setCustomValidity(whatsapp.value.trim() && !isPhoneNumber(whatsapp.value.trim()) ? invalid : '');
      };
      setDateBounds(); arrival.addEventListener('input', setDateBounds);
      phone.addEventListener('input', validatePhones); whatsapp.addEventListener('input', validatePhones);
      let busy = false;
      let leadBusy = false;
      let lastUserMessage = '';
      let conversation: string | undefined;
      let failedRequest: { text: string; id: string } | undefined;
      let enquiryRequestId: string | undefined;
      const operatorMessages = new Set<string>();
      const addMessage = (text: string, user = false) => {
        const p = document.createElement('p'); p.className = user ? 'message user' : 'message'; p.textContent = text;
        messages.append(p); messages.scrollTop = messages.scrollHeight; return p;
      };
      const setConversationStatus = (status: string) => {
        root.querySelector<HTMLElement>('.footnote')!.textContent = status === 'manual'
          ? (es ? 'El equipo de reservaciones atiende esta conversación.' : 'The reservations team is handling this conversation.')
          : (es ? 'Disponibilidad y tarifas confirmadas por reservas.' : 'Availability and rates confirmed by reservations.');
      };
      let polling = false;
      this.polling = setInterval(async () => {
        if (polling || busy || leadBusy || panel.hidden || !consent.checked || !conversation) return;
        polling = true;
        try {
          const response = await fetch(`/api/olivia/messages/?conversation=${encodeURIComponent(conversation)}`, { cache: 'no-store', signal: AbortSignal.timeout(12000) });
          if (!response.ok) return;
          const data = await response.json();
          setConversationStatus(data.status);
          for (const message of data.messages || []) {
            if (typeof message.id !== 'string' || typeof message.content !== 'string' || operatorMessages.has(message.id)) continue;
            operatorMessages.add(message.id);
            addMessage(`${es ? 'Reservaciones' : 'Reservations'}: ${message.content}`);
          }
        } catch { /* Keep the current conversation available during a polling failure. */ }
        finally { polling = false; }
      }, 5000);
      addMessage(es ? 'Hola, soy Olivia, tu concierge de villas. ¿Frente al mar en El Ensueño o sobre la bahía en El Murmullo? Cuéntame cómo imaginas tu estancia; te ayudo a descubrir las villas y a contactar a reservaciones.' : 'Hello, I’m Olivia, your villa concierge. Beachfront at El Ensueño or above the bay at El Murmullo? Tell me what your ideal stay looks like. I can help you explore the villas and connect with reservations.');
      const update = () => {
        input.disabled = !consent.checked || busy || leadBusy; sendButton.disabled = input.disabled;
        actions.forEach(button => { button.disabled = input.disabled; });
        openContact.disabled = busy || leadBusy; leadSubmit.disabled = !consent.checked || busy || leadBusy;
        back.disabled = leadBusy; consent.disabled = leadBusy;
        leadForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(field => { field.disabled = leadBusy; });
      };
      const showLead = (show: boolean) => {
        leadView.hidden = !show; leadButtons.hidden = !show; messages.hidden = show; actionSection.hidden = show; form.hidden = show; contact.hidden = show; error.hidden = true;
        if (show) { if (!leadMessage.value) leadMessage.value = lastUserMessage; leadName.focus(); } else input.focus();
      };
      openContact.addEventListener('click', () => showLead(true));
      back.addEventListener('click', () => showLead(false));
      const close = () => { panel.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.setAttribute('aria-label', openLabel); toggle.focus(); };
      toggle.addEventListener('click', () => { if (!panel.hidden) return close(); panel.hidden = false; toggle.setAttribute('aria-expanded', 'true'); toggle.setAttribute('aria-label', es ? 'Cerrar Olivia AI' : 'Close Olivia AI'); (consent.checked ? (leadView.hidden ? input : leadName) : consent).focus(); });
      root.querySelector('.close')!.addEventListener('click', close);
      root.addEventListener('keydown', (event) => { if ((event as KeyboardEvent).key === 'Escape' && !panel.hidden) close(); });
      consent.addEventListener('change', update); update();
      const send = async (text: string) => {
        if (!consent.checked || busy || !text.trim()) return;
        text = text.trim();
        addMessage(text, true); lastUserMessage = text; input.value = '';
        if (isBookingIntent(text)) {
          if (!leadMessage.value.includes(text)) leadMessage.value = [leadMessage.value, text].filter(Boolean).join('\n\n');
          showLead(true); return;
        }
        const requestId = failedRequest?.text === text ? failedRequest.id : crypto.randomUUID();
        busy = true; update(); error.hidden = true;
        const pending = addMessage(''); pending.classList.add('typing');
        const replyLabel = document.createElement('span'); replyLabel.className = 'sr-only'; replyLabel.textContent = es ? 'Olivia está respondiendo…' : 'Olivia is replying…'; pending.append(replyLabel);
        for (let index = 0; index < 3; index++) { const dot = document.createElement('span'); dot.className = 'typing-dot'; dot.setAttribute('aria-hidden', 'true'); pending.append(dot); }
        messages.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/api/olivia/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: text, language: es ? 'es' : 'en', conversation, page: location.pathname, requestId, consent: true }), signal: AbortSignal.timeout(60000) });
          const data = await response.json();
          if (typeof data.conversation === 'string') conversation = data.conversation;
          if (!response.ok) throw new Error(String(response.status));
          if (typeof data.answer !== 'string' || typeof data.conversation !== 'string') throw new Error('Invalid response');
          failedRequest = undefined; setConversationStatus(data.status);
          if (data.status === 'manual') { pending.remove(); return; }
          pending.classList.remove('typing'); pending.textContent = data.answer; conversation = data.conversation; this.dataset.version = data.version;
        } catch (err) {
          failedRequest = { text, id: requestId };
          pending.remove(); input.value = text;
          error.textContent = (err as Error).message === '429' ? (es ? 'Demasiados mensajes. Espera un minuto e inténtalo de nuevo.' : 'Too many messages. Wait a minute and try again.') : (es ? 'Olivia no está disponible ahora. Inténtalo de nuevo o contacta al equipo de reservas.' : 'Olivia is unavailable right now. Try again or contact reservations.');
          error.hidden = false;
        } finally { busy = false; update(); messages.removeAttribute('aria-busy'); messages.scrollTop = messages.scrollHeight; if (!panel.hidden) input.focus(); }
      };
      form.addEventListener('submit', event => { event.preventDefault(); void send(input.value); });
      actions.forEach(button => button.addEventListener('click', () => { void send(button.dataset.prompt!); }));
      leadForm.addEventListener('submit', async event => {
        event.preventDefault();
        if (!consent.checked || busy || leadBusy) return;
        setDateBounds(); validatePhones();
        if (!leadForm.reportValidity()) return;
        const fields = new FormData(leadForm);
        enquiryRequestId ||= crypto.randomUUID();
        leadBusy = true; update(); leadFeedback.textContent = es ? 'Enviando…' : 'Sending…';
        try {
          const response = await fetch('/api/olivia/contact/', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(60000),
            body: JSON.stringify({ contactFormVersion: 2, firstName: fields.get('firstName'), lastName: fields.get('lastName'), arrivalDate: fields.get('arrivalDate'), departureDate: fields.get('departureDate'), email: fields.get('email'), phone: fields.get('phone'), whatsapp: fields.get('whatsapp'), message: fields.get('message'), language: es ? 'es' : 'en', conversation, page: location.pathname, requestId: enquiryRequestId, consent: true }),
          });
          const data = await response.json();
          if (typeof data.conversation === 'string') conversation = data.conversation;
          if (!response.ok || data.submitted !== true) throw new Error('Enquiry not sent');
          enquiryRequestId = undefined;
          this.dataset.version = data.version; leadForm.reset(); setDateBounds(); leadFeedback.textContent = ''; showLead(false);
          addMessage(es ? 'Tu consulta y tu conversación se han enviado al equipo de reservaciones. Gracias.' : 'Your enquiry and conversation have been sent to our reservations team. Thank you.');
        } catch {
          leadFeedback.textContent = es ? 'No se pudo enviar tu consulta. Inténtalo de nuevo o escribe a sales.reservations@lacasaquecanta.com.' : 'Your enquiry could not be sent. Please try again or email sales.reservations@lacasaquecanta.com.';
        } finally { leadBusy = false; update(); if (!panel.hidden && leadView.hidden) input.focus(); }
      });
    }
  }
  if (!customElements.get('luxury-olivia')) customElements.define('luxury-olivia', LuxuryOlivia);
</script>
