---
interface Props { lang: 'en' | 'es'; }
const { lang } = Astro.props;
const es = lang === 'es';
---
<luxury-olivia lang={lang}>
  <template>
    <style is:inline>
      :host { position: fixed; right: 24px; bottom: 24px; z-index: 1000; font: 14px/1.5 'DM Sans', Arial, sans-serif; color: #2b2b2b; }
      * { box-sizing: border-box; } [hidden] { display: none !important; }
      button, input, textarea { font: inherit; } button, a { -webkit-tap-highlight-color: transparent; }
      button { cursor: pointer; } button:disabled { cursor: default; opacity: .5; }
      button:focus-visible, input:focus-visible, textarea:focus-visible, a:focus-visible { outline: 2px solid #c8aa70; outline-offset: 3px; }
      .toggle { display: grid; place-items: center; width: 64px; height: 64px; margin-left: auto; border-radius: 50%; background: linear-gradient(135deg, #3d3932, #171512); color: white; border: 1px solid #c8aa7070; box-shadow: 0 18px 40px -16px #0009, inset 0 1px 0 #ffffff30; }
      svg { width: 22px; height: 22px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
      .panel { position: absolute; bottom: 84px; right: 0; display: flex; flex-direction: column; width: 430px; max-width: calc(100vw - 32px); height: min(700px, calc(100dvh - 130px)); border: 1px solid #ded7c9; border-radius: 28px; background: #fffdf8; overflow: hidden; box-shadow: 0 46px 78px -28px #14100ac7, 0 22px 38px -26px #14100aa3, inset 0 1px 0 #ffffffcc; animation: enter .22s ease-out; }
      header { display: flex; align-items: flex-start; gap: 12px; padding: 20px; color: white; background: #2b2b2b; border-bottom: 1px solid #c8aa70; }
      .avatar { display: grid; place-items: center; width: 40px; height: 40px; flex: none; border-radius: 50%; background: #ffffff15; border: 1px solid #ffffff26; color: #f4d99a; }
      h2 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -.02em; }
      .brand { margin: 2px 0 7px; font-size: 11px; color: #ffffffb3; }
      .status { display: inline-flex; align-items: center; gap: 7px; border-radius: 20px; background: #ffffff15; padding: 3px 9px; font-size: 11px; }
      .dot { width: 7px; height: 7px; border-radius: 50%; background: #c8aa70; }
      .close { margin-left: auto; border: 0; border-radius: 50%; width: 30px; height: 30px; color: white; background: #ffffff15; font-size: 22px; line-height: 1; }
      .messages { flex: 1; min-height: 100px; overflow-y: auto; padding: 20px 16px; background: #f7f2e9; display: flex; flex-direction: column; gap: 12px; overscroll-behavior: contain; }
      .message { flex: none; max-width: 90%; padding: 12px 15px; margin: 0; border-radius: 18px 18px 18px 4px; background: white; box-shadow: 0 2px 8px #14100a0a; white-space: pre-wrap; overflow-wrap: anywhere; }
      .user { align-self: flex-end; background: #2b2b2b; color: white; border-radius: 18px 18px 4px 18px; }
      .actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; padding: 12px 16px; background: #f7f2e9; }
      .actions button { background: transparent; border: 1px solid #c8aa70; color: #5f5546; border-radius: 10px; font-size: 11px; font-weight: 600; padding: 8px 6px; }
      .consent { padding: 10px 16px; font-size: 11px; border-top: 1px solid #e8e0d3; background: #fffdf8; }
      .consent label { display: flex; align-items: flex-start; gap: 8px; } .consent input { accent-color: #2b2b2b; margin-top: 4px; }
      a { color: #806839; text-underline-offset: 3px; } .contact { display: flex; justify-content: space-between; padding: 0 16px 10px; font-size: 11px; }
      .chat-form { padding: 12px 16px; display: flex; gap: 8px; border-top: 1px solid #ded7c9; background: #fffdf8; }
      .chat-form input { min-width: 0; width: 100%; border-radius: 12px; border: 1px solid #ded7c9; background: white; padding: 12px; color: #2b2b2b; }
      .open-contact { padding: 0; border: 0; background: transparent; color: #806839; text-decoration: underline; text-underline-offset: 3px; }
      .lead-view { flex: 1; min-height: 0; overflow-y: auto; padding: 16px; }
      .lead-view h3 { margin: 0 0 8px; font-size: 17px; }
      .lead-view > p { margin: 0 0 14px; font-size: 12px; color: #625b51; }
      .lead-form { display: grid; gap: 10px; }
      .lead-form label { display: grid; gap: 4px; font-size: 12px; }
      .lead-form input, .lead-form textarea { width: 100%; min-width: 0; border: 1px solid #bfb5a4; border-radius: 8px; padding: 9px; background: white; color: #2b2b2b; }
      .lead-form textarea { resize: vertical; min-height: 80px; }
      .lead-buttons { display: flex; flex-wrap: wrap; gap: 8px; }
      .lead-submit, .back-to-chat { border: 1px solid #c8aa70; border-radius: 8px; padding: 9px 12px; background: #2b2b2b; color: white; }
      .back-to-chat { background: transparent; color: #5f5546; }
      .lead-feedback { margin: 0; color: #85402c; font-size: 12px; }
      .send { display: grid; place-items: center; border: none; border-radius: 12px; background: #2b2b2b; color: white; width: 46px; flex: none; }
      .error { margin: 0; padding: 7px 16px; background: #fff0e9; color: #85402c; font-size: 12px; }
      .footnote { padding: 0 16px 9px; font-size: 10px; color: #8b8275; text-align: center; }
      @keyframes enter { from { transform: translateY(12px); opacity: 0; } to { transform: none; opacity: 1; } }
      @media (max-width: 600px) { :host { right: 16px; bottom: 16px; } .panel { position: fixed; right: 12px; left: 12px; bottom: 92px; width: auto; max-width: none; height: min(660px, calc(100dvh - 110px)); border-radius: 24px; } header { padding: 16px; } .messages { padding: 16px; } }
      @media (prefers-reduced-motion: reduce) { .panel { animation: none; } }
    </style>
    <section class="panel" role="dialog" aria-labelledby="olivia-title" hidden>
      <header>
        <span class="avatar" aria-hidden="true">✧</span>
        <div><h2 id="olivia-title">Olivia AI</h2><p class="brand">Luxury Villas by La Casa Que Canta</p><span class="status"><span class="dot" aria-hidden="true"></span>{es ? 'Concierge digital' : 'Digital concierge'}</span></div>
        <button class="close" aria-label={es ? 'Cerrar el chat' : 'Close chat'} type="button">×</button>
      </header>
      <div class="messages" role="log" aria-live="polite" aria-relevant="additions text"></div>
      <div class="actions">
        <button type="button" data-prompt={es ? '¿Cuál es la diferencia entre El Ensueño y El Murmullo?' : 'What is the difference between El Ensueño and El Murmullo?'}>{es ? 'Las villas' : 'The villas'}</button>
        <button type="button" data-prompt={es ? '¿Para cuántas personas es cada villa?' : 'How many guests can stay in each villa?'}>{es ? 'Suites y huéspedes' : 'Suites & guests'}</button>
        <button type="button" data-prompt={es ? '¿Qué servicios ofrece cada villa?' : 'What services does each villa offer?'}>{es ? 'Servicios' : 'Services'}</button>
        <button type="button" data-prompt={es ? '¿Cómo puedo consultar disponibilidad y tarifas?' : 'How can I check availability and rates?'}>{es ? 'Disponibilidad y tarifas' : 'Availability & rates'}</button>
      </div>
      <section class="lead-view" aria-labelledby="olivia-contact-title" hidden>
        <h3 id="olivia-contact-title">{es ? 'Enviar una consulta' : 'Send an enquiry'}</h3>
        <p>{es ? 'Tus datos y tu conversación se enviarán a nuestro equipo de reservaciones.' : 'Your details and conversation will be sent to our reservations team.'}</p>
        <form class="lead-form">
          <label>{es ? 'Nombre completo' : 'Full name'}<input name="name" autocomplete="name" required maxlength="200" /></label>
          <label>{es ? 'Correo electrónico' : 'Email address'}<input name="email" type="email" autocomplete="email" required maxlength="254" /></label>
          <label>{es ? 'Teléfono (opcional)' : 'Phone (optional)'}<input name="phone" type="tel" autocomplete="tel" maxlength="60" /></label>
          <label>{es ? 'Tu consulta' : 'Your enquiry'}<textarea name="message" rows="3" required maxlength="5000"></textarea></label>
          <p class="lead-feedback" role="status" aria-live="polite"></p>
          <div class="lead-buttons"><button class="lead-submit" type="submit" disabled>{es ? 'Enviar consulta' : 'Send enquiry'}</button><button class="back-to-chat" type="button">{es ? 'Volver al chat' : 'Back to chat'}</button></div>
        </form>
      </section>
      <div class="consent"><label><input type="checkbox" /><span>{es ? 'He leído y acepto el ' : 'I have read and accept the '}<a href="/privacy-policy/" target="_blank" rel="noopener noreferrer">{es ? 'Aviso de Privacidad' : 'Privacy Notice'}</a>{es ? ' para conversar con Olivia. Al enviar una consulta, comparto mis datos y mi conversación con reservaciones.' : ' to chat with Olivia. When I send an enquiry, I share my details and conversation with reservations.'}</span></label></div>
      <div class="contact"><button class="open-contact" type="button">{es ? 'Enviar una consulta a reservaciones' : 'Send an enquiry to reservations'}</button></div>
      <p class="error" role="alert" hidden></p>
      <form class="chat-form"><input type="text" aria-label={es ? 'Tu mensaje' : 'Your message'} placeholder={es ? 'Escribe tu pregunta…' : 'Ask your question…'} maxlength="2000" disabled /><button class="send" type="submit" aria-label={es ? 'Enviar' : 'Send'} disabled><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg></button></form>
      <div class="footnote">{es ? 'Disponibilidad y tarifas confirmadas por reservas.' : 'Availability and rates confirmed by reservations.'}</div>
    </section>
    <button class="toggle" type="button" aria-label={es ? 'Abrir Olivia AI' : 'Open Olivia AI'} aria-expanded="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/></svg></button>
  </template>
</luxury-olivia>
<script>
  class LuxuryOlivia extends HTMLElement {
    connectedCallback() {
      if (this.shadowRoot) return;
      const template = this.querySelector('template');
      if (!template) return;
      const root = this.attachShadow({ mode: 'open' });
      root.append(template.content.cloneNode(true));
      const panel = root.querySelector<HTMLElement>('.panel')!;
      const toggle = root.querySelector<HTMLButtonElement>('.toggle')!;
      const input = root.querySelector<HTMLInputElement>('.chat-form input')!;
      const consent = root.querySelector<HTMLInputElement>('.consent input')!;
      const form = root.querySelector<HTMLFormElement>('.chat-form')!;
      const leadView = root.querySelector<HTMLElement>('.lead-view')!;
      const leadForm = root.querySelector<HTMLFormElement>('.lead-form')!;
      const leadName = root.querySelector<HTMLInputElement>('.lead-form [name="name"]')!;
      const leadMessage = root.querySelector<HTMLTextAreaElement>('.lead-form [name="message"]')!;
      const leadFeedback = root.querySelector<HTMLElement>('.lead-feedback')!;
      const leadSubmit = root.querySelector<HTMLButtonElement>('.lead-submit')!;
      const back = root.querySelector<HTMLButtonElement>('.back-to-chat')!;
      const openContact = root.querySelector<HTMLButtonElement>('.open-contact')!;
      const contact = root.querySelector<HTMLElement>('.contact')!;
      const actionSection = root.querySelector<HTMLElement>('.actions')!;
      const messages = root.querySelector<HTMLElement>('.messages')!;
      const error = root.querySelector<HTMLElement>('.error')!;
      const actions = [...root.querySelectorAll<HTMLButtonElement>('[data-prompt]')];
      const sendButton = root.querySelector<HTMLButtonElement>('.send')!;
      const es = this.lang === 'es';
      let busy = false;
      let leadBusy = false;
      let lastUserMessage = '';
      let conversation: string | undefined;
      const addMessage = (text: string, user = false) => {
        const p = document.createElement('p'); p.className = user ? 'message user' : 'message'; p.textContent = text;
        messages.append(p); messages.scrollTop = messages.scrollHeight; return p;
      };
      addMessage(es ? 'Hola, soy Olivia, tu concierge digital. Te ayudo a descubrir El Ensueño y El Murmullo y a planear tu estancia en Playa La Ropa. ¿Qué te gustaría saber?' : 'Hello, I’m Olivia, your digital concierge. I can help you discover El Ensueño and El Murmullo and plan your stay on Playa La Ropa. What would you like to know?');
      const update = () => {
        input.disabled = !consent.checked || busy || leadBusy; sendButton.disabled = input.disabled;
        actions.forEach(button => { button.disabled = input.disabled; });
        openContact.disabled = busy || leadBusy; leadSubmit.disabled = !consent.checked || busy || leadBusy;
        back.disabled = leadBusy; consent.disabled = leadBusy;
        leadForm.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input, textarea').forEach(field => { field.disabled = leadBusy; });
      };
      const showLead = (show: boolean) => {
        leadView.hidden = !show; messages.hidden = show; actionSection.hidden = show; form.hidden = show; contact.hidden = show; error.hidden = true;
        if (show) { if (!leadMessage.value) leadMessage.value = lastUserMessage; leadName.focus(); } else input.focus();
      };
      openContact.addEventListener('click', () => showLead(true));
      back.addEventListener('click', () => showLead(false));
      const close = () => { panel.hidden = true; toggle.setAttribute('aria-expanded', 'false'); toggle.focus(); };
      toggle.addEventListener('click', () => { if (!panel.hidden) return close(); panel.hidden = false; toggle.setAttribute('aria-expanded', 'true'); (consent.checked ? (leadView.hidden ? input : leadName) : consent).focus(); });
      root.querySelector('.close')!.addEventListener('click', close);
      root.addEventListener('keydown', (event) => { if ((event as KeyboardEvent).key === 'Escape' && !panel.hidden) close(); });
      consent.addEventListener('change', update); update();
      const send = async (text: string) => {
        if (!consent.checked || busy || !text.trim()) return;
        text = text.trim(); busy = true; update(); error.hidden = true;
        addMessage(text, true); lastUserMessage = text; input.value = '';
        const pending = addMessage(es ? 'Un momento…' : 'One moment…');
        messages.setAttribute('aria-busy', 'true');
        try {
          const response = await fetch('/api/olivia/', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ message: text, language: es ? 'es' : 'en', conversation, consent: true }), signal: AbortSignal.timeout(60000) });
          if (!response.ok) throw new Error(String(response.status));
          const data = await response.json();
          if (typeof data.answer !== 'string' || typeof data.conversation !== 'string') throw new Error('Invalid response');
          pending.textContent = data.answer; conversation = data.conversation; this.dataset.version = data.version;
        } catch (err) {
          pending.remove(); input.value = text;
          error.textContent = (err as Error).message === '429' ? (es ? 'Demasiados mensajes. Espera un minuto e inténtalo de nuevo.' : 'Too many messages. Wait a minute and try again.') : (es ? 'Olivia no está disponible ahora. Inténtalo de nuevo o contacta al equipo de reservas.' : 'Olivia is unavailable right now. Try again or contact reservations.');
          error.hidden = false;
        } finally { busy = false; update(); messages.removeAttribute('aria-busy'); messages.scrollTop = messages.scrollHeight; if (!panel.hidden) input.focus(); }
      };
      form.addEventListener('submit', event => { event.preventDefault(); void send(input.value); });
      actions.forEach(button => button.addEventListener('click', () => { void send(button.dataset.prompt!); }));
      leadForm.addEventListener('submit', async event => {
        event.preventDefault();
        if (!consent.checked || busy || leadBusy || !leadForm.reportValidity()) return;
        const fields = new FormData(leadForm);
        leadBusy = true; update(); leadFeedback.textContent = es ? 'Enviando…' : 'Sending…';
        try {
          const response = await fetch('/api/olivia/contact/', {
            method: 'POST', headers: { 'Content-Type': 'application/json' }, signal: AbortSignal.timeout(60000),
            body: JSON.stringify({ name: fields.get('name'), email: fields.get('email'), phone: fields.get('phone'), message: fields.get('message'), language: es ? 'es' : 'en', conversation, consent: true }),
          });
          const data = await response.json();
          if (!response.ok || data.submitted !== true) throw new Error('Enquiry not sent');
          this.dataset.version = data.version; leadForm.reset(); leadFeedback.textContent = ''; showLead(false);
          addMessage(es ? 'Tu consulta y tu conversación se han enviado al equipo de reservaciones. Gracias.' : 'Your enquiry and conversation have been sent to our reservations team. Thank you.');
        } catch {
          leadFeedback.textContent = es ? 'No se pudo enviar tu consulta. Inténtalo de nuevo o escribe a sales.reservations@lacasaquecanta.com.' : 'Your enquiry could not be sent. Please try again or email sales.reservations@lacasaquecanta.com.';
        } finally { leadBusy = false; update(); if (!panel.hidden && leadView.hidden) input.focus(); }
      });
    }
  }
  if (!customElements.get('luxury-olivia')) customElements.define('luxury-olivia', LuxuryOlivia);
</script>
