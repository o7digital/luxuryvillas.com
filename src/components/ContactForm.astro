---
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const copy = es ? {
  title: 'Hablemos de tu estancia', intro: 'Cuéntanos cómo imaginas tu escapada. Nuestro equipo te ayudará a planear cada detalle.',
  name: 'Nombre completo', email: 'Correo electrónico', message: 'Tu mensaje', send: 'Enviar mensaje',
  sending: 'Enviando…', success: 'Gracias. Tu mensaje ha sido enviado. Nuestro equipo se pondrá en contacto contigo.',
  error: 'No se pudo enviar tu mensaje. Inténtalo de nuevo o escríbenos a sales.reservations@lacasaquecanta.com.',
  privacy: 'Tu información se utilizará para responder a tu consulta.', policy: 'Política de privacidad', label: 'Contacto'
} : {
  title: 'Let’s plan your escape', intro: 'Tell us what you have in mind. Our team will help you shape every detail of your stay.',
  name: 'Full name', email: 'Email address', message: 'Your message', send: 'Send message',
  sending: 'Sending…', success: 'Thank you. Your message has been sent. Our team will be in touch.',
  error: 'Your message could not be sent. Please try again or email sales.reservations@lacasaquecanta.com.',
  privacy: 'We will use your information to respond to your enquiry.', policy: 'Privacy Policy', label: 'Contact'
};
---
<section class="contact-section" id="contact" aria-labelledby="contact-title">
  <div class="contact-intro">
    <p class="eyebrow">{copy.label}</p>
    <h2 id="contact-title">{copy.title}</h2>
    <p>{copy.intro}</p>
  </div>
  <form class="enquiry-form" action="https://formspree.io/f/moejlkyy" method="POST" data-sending={copy.sending} data-success={copy.success} data-error={copy.error}>
    <input type="hidden" name="_subject" value="Luxury Villas — Contact enquiry" />
    <div class="form-row">
      <label for="contact-name">{copy.name}<input id="contact-name" name="name" autocomplete="name" required maxlength="200" /></label>
      <label for="contact-email">{copy.email}<input id="contact-email" name="email" type="email" autocomplete="email" required maxlength="254" /></label>
    </div>
    <label for="contact-message">{copy.message}<textarea id="contact-message" name="message" rows="5" required maxlength="5000"></textarea></label>
    <p class="privacy-note">{copy.privacy} <a href="/privacy-policy/">{copy.policy}</a></p>
    <button class="submit-button" type="submit">{copy.send}<span aria-hidden="true">→</span></button>
    <p class="form-status" role="status" aria-live="polite" aria-atomic="true"></p>
  </form>
</section>
<style>
  .contact-section { scroll-margin-top: 7rem; padding: clamp(4rem, 8vw, 7rem) 7vw; background: #faf8f3; color: #141815; display: grid; grid-template-columns: 1fr 1.2fr; gap: clamp(2rem, 6vw, 6rem); }
  .eyebrow { text-transform: uppercase; letter-spacing: .2em; font-size: .75rem; color: #727b6a; }
  h2 { font-family: 'Playfair Display', Georgia, serif; font-weight: 400; font-size: clamp(2.5rem, 4vw, 4.5rem); line-height: 1.12; margin: 1rem 0 1.5rem; }
  .contact-intro > p:last-child { max-width: 26rem; color: #6e716a; }
  .enquiry-form { display: grid; gap: 1.3rem; }
  .form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.3rem; }
  label { display: grid; gap: .5rem; font-size: .85rem; }
  input, textarea { width: 100%; min-width: 0; padding: .9rem; border: 1px solid #b5b8ae; border-radius: 0; background: #fff; color: #141815; font: inherit; }
  textarea { resize: vertical; }
  input:focus-visible, textarea:focus-visible, button:focus-visible { outline: 2px solid #727b6a; outline-offset: 3px; }
  .privacy-note { font-size: .75rem; color: #6e716a; margin: 0; }
  .privacy-note a { color: inherit; text-decoration: underline; }
  .submit-button { display: flex; justify-content: space-between; align-items: center; gap: 2rem; padding: 1rem 1.5rem; border: 0; background: #141815; color: #fff; cursor: pointer; font: inherit; text-transform: uppercase; letter-spacing: .13em; font-size: .8rem; justify-self: start; }
  .submit-button:disabled { opacity: .65; cursor: wait; }
  .form-status { margin: 0; font-size: .9rem; }
  .form-status:empty { display: none; }
  @media (max-width: 760px) { .contact-section { grid-template-columns: 1fr; padding: 4rem 1.3rem; } .form-row { grid-template-columns: 1fr; } .submit-button { width: 100%; } }
</style>
<script>
  document.querySelectorAll<HTMLFormElement>('.enquiry-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
      const status = form.querySelector<HTMLElement>('.form-status')!;
      if (button.disabled) return;
      button.disabled = true;
      status.textContent = form.dataset.sending!;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!response.ok) throw new Error('Submission failed');
        form.reset();
        status.textContent = form.dataset.success!;
      } catch {
        status.textContent = form.dataset.error!;
      } finally {
        button.disabled = false;
      }
    });
  });
</script>
