---
interface Props {
  title: string;
  description: string;
  path: string;
  lang: 'en' | 'es';
  localized?: boolean;
}
const { title, description, path, lang, localized = false } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const image = new URL('/assets/hero-playa-la-ropa.webp', Astro.site).href;
const imageAlt = lang === 'es' ? 'Playa La Ropa y la costa de Zihuatanejo, México' : 'Playa La Ropa and the coastline of Zihuatanejo, Mexico';
---
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{localized && <>
  <link rel="alternate" hreflang="en" href={new URL('/', Astro.site).href} />
  <link rel="alternate" hreflang="es" href={new URL('/es/', Astro.site).href} />
  <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site).href} />
</>}
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Luxury Villas by La Casa Que Canta" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={lang === 'es' ? 'es_MX' : 'en_US'} />
{localized && <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_MX'} />}
<meta property="og:image" content={image} />
<meta property="og:image:type" content="image/webp" />
<meta property="og:image:width" content="2000" />
<meta property="og:image:height" content="1125" />
<meta property="og:image:alt" content={imageAlt} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
<meta name="twitter:image:alt" content={imageAlt} />
